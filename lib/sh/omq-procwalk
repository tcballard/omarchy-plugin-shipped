#!/usr/bin/env bash
set -euo pipefail
base=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
exec node -e 'const c=require(process.argv[1]);const p=c.proc(Number(process.argv[2]));if(!p)process.exit(1);console.log(JSON.stringify({...p,parents:c.ancestors(p,c.processes())}))' "$base/js/core.cjs" "$@"
