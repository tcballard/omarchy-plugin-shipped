#!/usr/bin/env bash
set -euo pipefail
base=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
exec node -e 'const c=require(process.argv[1]);c.gitScan({roots:process.argv.slice(2)}).then(rows=>rows.forEach(r=>console.log(JSON.stringify(r)))).catch(e=>{console.error(e.message);process.exitCode=1})' "$base/js/core.cjs" "$@"
